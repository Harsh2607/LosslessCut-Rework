{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main/index.ts",
    "src/preload/index.ts",
    "src/renderer/src/index.tsx",
    "src/renderer/src/stores/index.ts",
    "script/**/*.{ts,js}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "script/**/*.{ts,js}"
  ],
  "ignoreDependencies": [
    "@radix-ui/colors",
    "@fontsource/open-sans",
    "@types/*",
    "electron",
    "playwright-core",
    "@biomejs/biome",
    "@commitlint/*",
    "@playwright/test",
    "@axe-core/playwright",
    "lefthook",
    "cross-env",
    "rollup-plugin-visualizer",
    "type-coverage"
  ],
  "ignoreBinaries": [
    "rimraf",
    "licenses",
    "7z",
    "ffmpeg",
    "xdotool"
  ]
}
